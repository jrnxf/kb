{
  "description": "Inject saved kb notes at every session start, also after /clear and compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
