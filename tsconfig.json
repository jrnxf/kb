{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "cli",
    "hooks",
    "test"
  ],
  "exclude": [
    "hooks/clear-after-save.ts",
    "hooks/clear-after-save.test.ts"
  ]
}
