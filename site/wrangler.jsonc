{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A static site. worker.ts only redirects http: to https:, and passes the rest to the files in dist/.
  "main": "worker.ts",
  "name": "kb-site",
  "compatibility_date": "2026-11-01",
  // An unknown path gets dist/404.html with a 404 status.
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "routes": [{ "pattern": "kb.jrnxf.co", "custom_domain": true }],
  "observability": { "enabled": true }
}
