{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A static site: no Worker code, only the files in dist/.
  "name": "kb-site",
  "compatibility_date": "2026-11-01",
  // An unknown path gets dist/404.html with a 404 status.
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "kb.jrnxf.co", "custom_domain": true }],
  "observability": { "enabled": true }
}
